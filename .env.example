# ─────────────────────────────────────────────────────────────
# AI CFO — Environment Variables
# Copy this file to `.env`. NONE are required to run the app locally.
# ─────────────────────────────────────────────────────────────

# ── Read by the app today ────────────────────────────────────

# AI assistant provider chain: OpenAI → Gemini → offline analyzer.
# Set EITHER key to enable live generative answers; with neither, the
# assistant uses a deterministic analyzer over your real data (never fabricates).

# OpenAI — preferred when set. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — used if OpenAI is not set. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Canonical base URL for SEO / OpenGraph metadata (set to your deployed URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Scaffolding for the planned backend (roadmap M5) ─────────
# NOT read by the app today — present so the intended production shape is
# legible. Wiring these up is the backend milestone.

# Database (Prisma) — e.g. postgresql://user:pass@host:5432/aicfo
DATABASE_URL=

# Server-side auth (JWT / session)
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Transactional email (SMTP) — verification & password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI CFO <no-reply@aicfo.app>"
