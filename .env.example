# ─────────────────────────────────────────────────────────────
# AI CFO — Environment Variables
# Copy this file to `.env` and fill in the values before deploying.
# All values are intentionally left empty for local/hackathon setup.
# ─────────────────────────────────────────────────────────────

# Database (Prisma) — e.g. postgresql://user:pass@host:5432/aicfo
DATABASE_URL=

# Google Gemini API (AI features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Auth
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email (SMTP) — used for verification & password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI CFO <no-reply@aicfo.app>"

# App
NEXT_PUBLIC_APP_NAME="AI CFO"
NEXT_PUBLIC_APP_URL=http://localhost:3000
