{
  "name": "ai-cfo",
  "version": "1.0.0",
  "private": true,
  "description": "AI CFO — Your AI-powered Chief Financial Officer for Small & Medium Businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
